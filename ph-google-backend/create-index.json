{
  "settings": {
    "number_of_shards": "1",
    "number_of_replicas": "0",
    "refresh_interval": "1s",
    "analysis": {
      "filter": {
        "ph_synonyms": {
          "type": "synonym_graph",
          "lenient": "true",
          "synonyms": [
            "ai, artificial intelligence",
            "ml, machine learning",
            "js, javascript",
            "ts, typescript",
            "py, python",
            "db, database",
            "os, operating system",
            "ui, user interface",
            "ux, user experience",
            "api, application programming interface",
            "cpu, processor",
            "gpu, graphics card",
            "pc, computer",
            "laptop, notebook computer",
            "cellphone, mobile phone, smartphone",
            "www, web, internet",
            "car, automobile, motorcar",
            "tv, television",
            "film, movie",
            "photo, photograph, picture",
            "doctor, physician",
            "holiday, vacation",
            "football, soccer",
            "bike, bicycle",
            "plane, aeroplane, airplane",
            "kid, child",
            "usa, united states, america",
            "uk, united kingdom, britain",
            "uae, united arab emirates",
            "mumbai, bombay",
            "chennai, madras",
            "kolkata, calcutta",
            "bengaluru, bangalore"
          ]
        },
        "ph_stemmer": {
          "type": "kstem"
        },
        "ph_word_delimiter": {
          "split_on_numerics": "true",
          "generate_word_parts": "true",
          "preserve_original": "true",
          "catenate_words": "false",
          "generate_number_parts": "true",
          "split_on_case_change": "true",
          "type": "word_delimiter_graph",
          "catenate_numbers": "false",
          "stem_english_possessive": "true"
        },
        "ph_english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        }
      },
      "char_filter": {
        "ph_url_cleaner": {
          "pattern": "(https?://|www\\.|[/._\\-?=&#+])",
          "type": "pattern_replace",
          "replacement": " "
        }
      },
      "normalizer": {
        "ph_lowercase": {
          "filter": [
            "lowercase"
          ],
          "type": "custom"
        }
      },
      "analyzer": {
        "ph_search": {
          "filter": [
            "lowercase",
            "asciifolding",
            "ph_synonyms",
            "ph_word_delimiter",
            "ph_english_stop",
            "ph_stemmer"
          ],
          "type": "custom",
          "tokenizer": "standard"
        },
        "ph_url": {
          "filter": [
            "lowercase",
            "asciifolding"
          ],
          "char_filter": [
            "ph_url_cleaner"
          ],
          "type": "custom",
          "tokenizer": "standard"
        },
        "ph_text": {
          "filter": [
            "lowercase",
            "asciifolding",
            "ph_word_delimiter",
            "ph_english_stop",
            "ph_stemmer"
          ],
          "type": "custom",
          "tokenizer": "standard"
        },
        "ph_exact": {
          "filter": [
            "lowercase",
            "asciifolding"
          ],
          "type": "custom",
          "tokenizer": "standard"
        }
      }
    },
    "mapping": {
      "total_fields": {
        "limit": "200"
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "author": {
        "type": "keyword",
        "ignore_above": 256
      },
      "canonicalUrl": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "content": {
        "type": "text",
        "fields": {
          "exact": {
            "type": "text",
            "analyzer": "ph_exact"
          }
        },
        "analyzer": "ph_text",
        "search_analyzer": "ph_search"
      },
      "contentHash": {
        "type": "keyword"
      },
      "contentType": {
        "type": "keyword"
      },
      "country": {
        "type": "keyword",
        "normalizer": "ph_lowercase"
      },
      "crawledAt": {
        "type": "date"
      },
      "description": {
        "type": "text",
        "fields": {
          "exact": {
            "type": "text",
            "analyzer": "ph_exact"
          }
        },
        "analyzer": "ph_text",
        "search_analyzer": "ph_search"
      },
      "domain": {
        "type": "keyword",
        "normalizer": "ph_lowercase",
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "ph_url"
          }
        }
      },
      "hasDescription": {
        "type": "boolean"
      },
      "headings": {
        "type": "text",
        "fields": {
          "exact": {
            "type": "text",
            "analyzer": "ph_exact"
          }
        },
        "analyzer": "ph_text",
        "search_analyzer": "ph_search"
      },
      "imageCount": {
        "type": "integer"
      },
      "imageUrl": {
        "type": "keyword",
        "index": false,
        "ignore_above": 2048
      },
      "isArticle": {
        "type": "boolean"
      },
      "keywords": {
        "type": "text",
        "analyzer": "ph_text",
        "search_analyzer": "ph_search"
      },
      "language": {
        "type": "keyword",
        "normalizer": "ph_lowercase"
      },
      "outboundLinkCount": {
        "type": "integer"
      },
      "pageId": {
        "type": "keyword"
      },
      "path": {
        "type": "text",
        "analyzer": "ph_url"
      },
      "publishedAt": {
        "type": "date"
      },
      "qualityScore": {
        "type": "half_float"
      },
      "rootDomain": {
        "type": "keyword",
        "normalizer": "ph_lowercase"
      },
      "section": {
        "type": "keyword",
        "ignore_above": 128
      },
      "siteName": {
        "type": "keyword",
        "ignore_above": 256
      },
      "statusCode": {
        "type": "short"
      },
      "title": {
        "type": "text",
        "fields": {
          "exact": {
            "type": "text",
            "analyzer": "ph_exact"
          },
          "raw": {
            "type": "keyword",
            "ignore_above": 512,
            "normalizer": "ph_lowercase"
          }
        },
        "analyzer": "ph_text",
        "search_analyzer": "ph_search"
      },
      "titleLength": {
        "type": "short"
      },
      "uniqueWordRatio": {
        "type": "half_float"
      },
      "updatedAt": {
        "type": "date"
      },
      "url": {
        "type": "text",
        "fields": {
          "raw": {
            "type": "keyword",
            "ignore_above": 2048
          }
        },
        "analyzer": "ph_url"
      },
      "urlHash": {
        "type": "keyword"
      },
      "videoCount": {
        "type": "integer"
      },
      "wordCount": {
        "type": "integer"
      }
    }
  }
}