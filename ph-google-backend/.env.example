# ---------------------------------------------------------------
# PH-Google backend configuration
# Copy this file to .env and fill in the values. Never commit .env.
#
# REQUIRED in production (the server refuses to start without them):
#   MONGO_URI, JWT_SECRET (32+ characters), FRONTEND_URL
# Under docker-compose.prod.yml, NODE_ENV, LOG_LEVEL, FRONTEND_URL,
# REDIS_URL, OPENSEARCH_NODE and TRUST_PROXY are set by Compose and override
# the values here. See DEPLOYMENT.md.
# ---------------------------------------------------------------

# --- Core ------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
#   Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>
#   Local: mongodb://127.0.0.1:27017/ph-google
MONGO_URI=mongodb://127.0.0.1:27017/ph-google
# Secret used to sign JWTs. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Required in production; localhost:3000 / :5173 are allowed automatically
# in development. In production: the exact site origin, e.g.
# https://search.example.com (scheme + host, no path, no trailing slash).
FRONTEND_URL=http://localhost:3000

# --- Proxies ---------------------------------------------------
# How many proxies in front of the API to trust for the client's address
# (X-Forwarded-For) — this is what the rate limits count as one client.
#   1 (default)  the frontend's nginx (docker-compose.prod.yml). Keep 1 even
#                behind a load balancer: nginx sets X-Forwarded-For itself, so
#                configure its real_ip lines instead (DEPLOYMENT.md)
#   0 / false    nothing in front: the API is reached directly
# Never set more hops than really exist: clients could then forge their address.
# TRUST_PROXY=1

# --- Logging ---------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# --- Search limits ---------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_MAX_PAGE=500
SEARCH_MAX_QUERY_LENGTH=200

# --- Crawler ---------------------------------------------------
# A crawler that does not say who it is, and how to ask it to stop, is a
# nuisance to every site it visits. Point this at a page describing the bot;
# it is appended to the User-Agent as "PH-SearchBot/1.0 (+<url>)".
CRAWLER_CONTACT_URL=

# Overrides the whole User-Agent string, contact URL included.
# Never put "Googlebot" in it: sites (Wikipedia included) reject anything
# that looks like an impersonation of Google's crawler with a 403.
# CRAWLER_USER_AGENT=PH-SearchBot/1.0 (+https://example.com/bot)
# Hard ceiling on pages per crawl job, whatever the admin requests
CRAWLER_MAX_PAGES_LIMIT=200
CRAWLER_DEFAULT_MAX_PAGES=10
# Politeness delay between requests, in ms (robots.txt Crawl-delay wins)
CRAWLER_DELAY_MS=1000
CRAWLER_MAX_DELAY_MS=30000
CRAWLER_TIMEOUT_MS=8000
CRAWLER_MAX_TERMS_PER_PAGE=5000
# Crawls open at once. A topic crawl (many seeds) counts as one.
CRAWLER_MAX_CONCURRENT_JOBS=2
# Largest page body buffered, in bytes (5 MB). Bigger pages are skipped.
CRAWLER_MAX_PAGE_BYTES=5242880
# Links from one page that may enter the crawl queue. Keeps a link-heavy
# page (an encyclopedia article has ~1,000) from flooding the frontier.
CRAWLER_MAX_LINKS_PER_PAGE=100

# --- Topic crawls (seed catalog) --------------------------------
# Topics and their seed URLs live in config/crawlSeeds.json. Point this at
# another JSON file with the same shape to use your own catalog instead.
# CRAWLER_SEEDS_FILE=./config/my-seeds.json
# Pages each seed may crawl. Start small and raise it once search results
# look right.
CRAWLER_SEED_PAGES_PER_SEED=5
# How many links away from a seed a topic crawl may go.
CRAWLER_SEED_MAX_DEPTH=2
# Ceiling on one whole topic crawl: seeds x pages per seed must fit under it.
CRAWLER_MAX_PAGES_PER_CRAWL=300

# --- Continuous crawl --------------------------------------------
# false: a job that spends its page budget skips the URLs it never reached.
# true:  those URLs stay pending, and the maintenance sweep starts a
#        continuation job (same seed, scope, depth and page budget) to crawl
#        them. Every job is still bounded by its own page budget, and a
#        continuation takes over its parent's crawl slot.
CRAWLER_CONTINUOUS=false
# Continuations one crawl may chain before its remaining URLs are skipped.
CRAWLER_CONTINUOUS_MAX_CONTINUATIONS=10

# --- Sitemap discovery -------------------------------------------
# true: after a crawl's first page on a host is indexed, the worker reads that
# host's sitemaps once per crawl chain and adds their URLs to the frontier,
# within the job's scope and budget.
CRAWLER_SITEMAPS=false
# Sitemap files fetched per host in one discovery run, failures included.
CRAWLER_SITEMAP_MAX_FILES=5
# How deep sitemap indexes may nest below the files robots.txt names.
CRAWLER_SITEMAP_MAX_DEPTH=2
# Most URLs one discovery run may add to the frontier.
CRAWLER_SITEMAP_MAX_URLS=200
# The parser stops reading a file after this many <loc> entries.
CRAWLER_SITEMAP_MAX_URLS_PER_FILE=5000
# Largest sitemap file in bytes, as downloaded and after decompression (10 MB).
CRAWLER_SITEMAP_MAX_BYTES=10485760
# Try /sitemap.xml when robots.txt names no sitemap.
CRAWLER_SITEMAP_FALLBACK=true
# A discovery still running after this long (15 min) is taken over by the next
# worker that reaches the host.
CRAWLER_SITEMAP_DISCOVERY_LEASE_MS=900000
# Attempts per crawl chain and host. Only temporary failures (timeouts,
# server errors) are retried.
CRAWLER_SITEMAP_DISCOVERY_MAX_ATTEMPTS=2

# --- Rate limiting ---------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_CRAWLER_WINDOW_MS=60000
RATE_LIMIT_CRAWLER_MAX=20
# Set true to switch limiting off entirely (local development only)
DISABLE_RATE_LIMIT=false

# --- AI answers (retrieval-augmented generation) ----------------
# The answer shown above the web results. It is written by a language model
# from the documents the search engine retrieves for the query, with the
# sources it cites. Everything here is OPTIONAL: with no API key the endpoint
# answers "not configured" and search works exactly as before.
#
# The one setting needed to switch the feature on. Server-side only: it is
# never sent to the browser and never logged. Get a key at
# https://console.anthropic.com/ (ANTHROPIC_API_KEY is read as a fallback).
# AI_API_KEY=sk-ant-...

# Set to false to turn AI answers off without removing the key.
# AI_ANSWERS_ENABLED=true

# Which provider in services/ai/llm/ writes the answer, and which model.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5

# How hard the model works: low | medium | high | xhigh | max. Low keeps the
# answer box fast. Leave empty for a model that does not accept the setting
# (for example claude-haiku-4-5).
# AI_EFFORT=low

# Ceiling on one response (the model's reasoning included), and how long to
# wait for it before reporting "temporarily unavailable".
# AI_MAX_OUTPUT_TOKENS=8000
# AI_TIMEOUT_MS=30000

# Re-run a request the model's safety system declined on the provider's
# recommended fallback model. Set to false for a model or gateway that does
# not support it.
# AI_REFUSAL_FALLBACK=true

# Only for a proxy or gateway in front of the provider.
# AI_BASE_URL=

# Retrieval: search results fetched as candidates, sources given to the
# model, and the share of the best match's score a candidate must reach.
# AI_RETRIEVAL_COUNT=8
# AI_MAX_SOURCES=5
# AI_MIN_RELATIVE_SCORE=0.3

# Context size, in characters: per source, in total, and the least usable
# evidence worth calling the model for.
# AI_MAX_CHARS_PER_SOURCE=1800
# AI_MAX_CONTEXT_CHARS=8000
# AI_MIN_EVIDENCE_CHARS=200

# Identical questions within this window reuse the answer (0 disables), and
# how many answers are kept. In-process; nothing is stored in Redis.
# AI_CACHE_TTL_MS=600000
# AI_CACHE_MAX_ENTRIES=200

# AI answer requests allowed per client per window. Tighter than search,
# because each uncached answer is a paid model call.
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX=20


# --- Tests -----------------------------------------------------
# Optional: point the test suite at a real MongoDB instead of the in-memory
# server. Must be a DEDICATED test database - the suite clears it between tests.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/ph-google-test

# --- OpenSearch (search engine) --------------------------------
# Start it locally with:  docker compose up -d   (from the repo root)
# Stop it with:           docker compose down
#
# MongoDB stores application data (users, history, analytics, crawl jobs).
# OpenSearch powers web search: the page index, relevance and ranking.
# Running on the host (npm start / npm test):
OPENSEARCH_NODE=http://localhost:9200
# Inside docker compose this is overridden with http://opensearch:9200 —
# localhost in a container is the container itself, not the host.
# Leave both blank for the default local container, which runs with the
# security plugin disabled. Fill them in when running a secured cluster.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=ph-google-pages

# Set false only for a local cluster using a self-signed certificate.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true

OPENSEARCH_REQUEST_TIMEOUT_MS=10000
OPENSEARCH_PING_TIMEOUT_MS=3000
OPENSEARCH_MAX_RETRIES=2
# Documents per bulk request during a reindex.
OPENSEARCH_BULK_BATCH_SIZE=250
# A single-node laptop cluster: one shard, no replicas (a replica on a
# one-node cluster stays unassigned and turns the index health yellow).
OPENSEARCH_SHARDS=1
OPENSEARCH_REPLICAS=0

# Which engine answers web search.
#   opensearch  the architecture (default)
#   mongo       explicit rollback to the superseded inverted index
# There is no automatic fallback: if OpenSearch is down the API returns 503
# rather than silently serving weaker results from a different engine.
SEARCH_ENGINE=opensearch

# --- More test settings ----------------------------------------
# None of these belong in a deployed .env; they configure test runs.

# The index the search-quality suite creates and destroys. It must never be
# the production index name: the suite recreates it from scratch.
# OPENSEARCH_INDEX_TEST=ph-google-pages-test

# Set true to make an unreachable OpenSearch cluster FAIL the test run rather
# than skip the search-quality suite. CI sets this, because a dead cluster
# there is a broken build and not a shorter test run. Leave it unset locally
# so `npm test` still works without `docker compose up`.
# OPENSEARCH_REQUIRED=true

# OPENSEARCH_AVAILABLE is set by tests/helpers/globalSetup.js, never by you.
# Listed here only so nobody wonders where it comes from.

# Set true to let the crawler test fetch a real page over the network. Off by
# default, so the suite passes on a machine with no internet access.
# RUN_LIVE_CRAWL=true

# --- Command-line scripts --------------------------------------
# Read by scripts, never by the server. Prefer passing these on the command
# line so a password never rests in a file:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='...' npm run verify

# npm run create-admin — the account it creates or promotes.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# npm run verify — which server to exercise, and whether the smoke test
# includes a real crawl of CRAWL_SEED_URL.
# BASE_URL=http://localhost:5000
# CRAWL_SEED_URL=https://example.com

# Accepted as an alias for FRONTEND_URL, for deployments that already set it.
# FRONTEND_URLS=

# --- Crawl queue (Redis) ---------------------------------------
# Redis carries the crawl queue and nothing else. The frontier, every crawl
# job and all crawl results are in MongoDB, so losing Redis costs the
# queue's position rather than the crawl: the worker's next maintenance
# sweep rebuilds the queue from the frontier.
#
# Start it with:  docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379
# Inside docker compose this is overridden with redis://redis:6379.

# Namespaces the queue's Redis keys. Change it to run two environments
# against one Redis.
CRAWLER_QUEUE_PREFIX=ph-google
# Finished jobs kept for the admin view, so Redis cannot grow without limit.
CRAWLER_QUEUE_KEEP_COMPLETED=200
CRAWLER_QUEUE_KEEP_FAILED=500

# --- Crawl worker ----------------------------------------------
# Run it with:  npm run worker   (or the `worker` service in compose)
#
# How many HOSTS the worker crawls at once. Politeness is per host — the
# queue job id is the hostname, so no two slices of one site can run
# together — which makes this cross-domain parallelism, not a request rate.
CRAWLER_WORKER_CONCURRENCY=4

# Pages one host lease handles before yielding its worker slot. Without a
# slice, a site with 50,000 pages would hold a slot until it finished and
# every other host would queue behind it.
CRAWLER_HOST_SLICE_PAGES=10

# A URL claimed but never released — the worker was killed mid-fetch —
# returns to the frontier after this long.
CRAWLER_LEASE_TIMEOUT_MS=120000

# How often the sweep reclaims stale leases, re-queues pages due for a
# re-crawl, closes finished jobs and enqueues hosts with work waiting.
CRAWLER_MAINTENANCE_INTERVAL_MS=60000

# A running crawl showing no progress for this long, while the crawler is
# running, is failed as abandoned. Long on purpose: topic-crawl seeds sharing
# one site wait their turn for many minutes.
CRAWLER_ORPHAN_TIMEOUT_MS=1800000

# A crawled page becomes eligible for re-crawling after this many days.
CRAWLER_RECRAWL_AFTER_DAYS=7

# Attempts before a frontier URL is abandoned. Retries back off 1, 4, 9 min.
CRAWLER_MAX_ATTEMPTS_PER_URL=3

# Link depth from the seed, and the ceiling an admin request cannot exceed.
CRAWLER_DEFAULT_MAX_DEPTH=3
CRAWLER_MAX_DEPTH_LIMIT=10

# --- More test settings (queue) --------------------------------
# Set true to make an unreachable Redis FAIL the test run rather than skip
# the crawl-queue suite. CI sets this. Leave it unset locally so `npm test`
# works without `docker compose up`.
# REDIS_REQUIRED=true
# REDIS_AVAILABLE is set by tests/helpers/globalSetup.js, never by you.

# ---------------------------------------------------------------------------
# External web search — SerpApi (Google web results)
# ---------------------------------------------------------------------------
# Google results added AFTER the index's own results on the first page of a
# web search. OPTIONAL and OFF by default: while off, or with no key, no
# request is ever made and search behaves exactly as without it. Never used by
# AI answers; nothing from SerpApi is stored. See docs/SERPAPI.md.
#
# Server-side only: never sent to the browser, never logged, never in a
# VITE_* variable. Only the key itself (64 characters from
# https://serpapi.com/manage-api-key), not a whole search URL.
# SERPAPI_API_KEY=

# Switch it on. Anything but "true" is off.
# SERPAPI_ENABLED=false

# Only "google" (web search) is implemented.
# SERPAPI_ENGINE=google

# Give up on SerpApi after this long; the index's results are shown anyway.
# SERPAPI_WEB_TIMEOUT_MS=3000
# (SERPAPI_TIMEOUT_MS is the older name for the same setting; the new one wins.)

# The same for the Images, Videos and Maps tabs, where SerpApi is the whole
# result, so it is worth waiting longer.
# SERPAPI_VERTICAL_TIMEOUT_MS=8000

# Google results shown under the index's results (at most 10).
# SERPAPI_MAX_RESULTS=10

# Optional localisation: a SerpApi location name, a country code, and the
# interface language.
# SERPAPI_LOCATION=
# SERPAPI_GL=
# SERPAPI_HL=en

# Identical searches within this window reuse the stored response (0
# disables), and how many responses are kept. In-process; not Redis.
# SERPAPI_CACHE_TTL_MS=600000
# SERPAPI_CACHE_MAX_ENTRIES=200

# Successful requests per UTC day by the backend process (a failed request is
# not counted: SerpApi does not charge for it); past it SerpApi is skipped
# until midnight. The free plan is 250 searches a month (~8 a day). 0 = no cap.
# SERPAPI_DAILY_LIMIT=8

# 0: ask on every eligible first page, in parallel with the index.
# N: ask only when the index found fewer than N results (saves searches).
# SERPAPI_MIN_INTERNAL_RESULTS=0

# Requests in flight at once; a search beyond this skips SerpApi.
# SERPAPI_MAX_CONCURRENT=2

# Only for tests (a local stand-in) or a proxy.
# SERPAPI_BASE_URL=https://serpapi.com

# ---------------------------------------------------------------------------
# Image download (the Download button in image search)
# ---------------------------------------------------------------------------
# GET /api/images/download fetches one image from the image results and
# returns it as a file. It only fetches addresses this server signed in the
# search response, only from public hosts, and only real images. See
# docs/SERPAPI.md ("Image preview and download"). Nothing needs to be set.
#
# One deadline for the whole fetch, the largest image handed on, and how many
# redirects are followed (each one is checked like the first address).
# IMAGE_DOWNLOAD_TIMEOUT_MS=8000
# IMAGE_DOWNLOAD_MAX_BYTES=15728640
# IMAGE_DOWNLOAD_MAX_REDIRECTS=3

# Downloads allowed per client per window.
# RATE_LIMIT_IMAGE_WINDOW_MS=60000
# RATE_LIMIT_IMAGE_MAX=30

# ---------------------------------------------------------------------------
# Trending now (the homepage card)
# ---------------------------------------------------------------------------
# GET /api/trending returns current trending searches for a country, from
# SerpApi's Google Trends "Trending Now" engine. It needs nothing but the
# SerpApi settings above (SERPAPI_API_KEY, SERPAPI_ENABLED=true); with those
# off the card shows its built-in topics instead.
#
# The country used when a request names none (ISO code: IN, US, GB, AU, …).
# TRENDING_REGION=IN

# How long fetched trends are served before asking again. Every refresh is
# one SerpApi search and counts toward SERPAPI_DAILY_LIMIT, so on a small
# plan a longer value (3600000 = 1 hour) leaves more searches for results.
# Give up on a trends refresh after this long (1000-20000).
# TRENDING_TIMEOUT_MS=8000

# TRENDING_CACHE_TTL_MS=600000

# Trends returned to the homepage (the card shows the first five).
# TRENDING_MAX_ITEMS=8

# ---------------------------------------------------------------------------
# External web results: which provider, and Bing (RapidAPI)
# ---------------------------------------------------------------------------
# The index always answers first. On page 1 of a web search, extra results
# from one external provider are appended after the index's results.
#
# Which provider supplies them: serpapi (Google, the default), bing or
# parallel. Not the same as SEARCH_ENGINE above, which chooses the index
# itself. EXTERNAL_SEARCH_PROVIDER is the same setting under a clearer name
# and wins when both are set.
# SEARCH_PROVIDER=
# EXTERNAL_SEARCH_PROVIDER=

# When the chosen provider cannot answer (timeout, outage, rate limit, rejected
# key), ask the others that are configured. Set to false to use the chosen
# provider exclusively — for example Parallel with no SerpApi fallback.
# SEARCH_PROVIDER_FALLBACK=true

# Relevance gate (OpenSearch engine). A count of matches says nothing about
# whether any of them answers the query, so the index also reports whether it
# holds a page ABOUT the query: every query word in the title, headings,
# description, keywords or URL. When it holds none, the provider is asked
# even if SERPAPI_MIN_INTERNAL_RESULTS was met, and its results are placed
# before the index's instead of after. When it holds one, nothing changes.
# Set to false to go back to the count rule alone, index always first.
# EXTERNAL_RELEVANCE_GATE=true

# Check that a provider's web results cover the query's meaningful words
# (not stop words, not "best"/"top"/"latest") before they are shown or cached.
# A list that does not is rejected; SerpApi is asked once more for a fresh
# copy (one extra search), then the other provider. Set to false to accept
# whatever arrives.
# EXTERNAL_RESULT_VALIDATION=true

# Bing web search through RapidAPI ("bing-search-apis"). Needed only for
# SEARCH_PROVIDER=bing (or as the fallback for serpapi). Server-side only:
# sent as a request header, never logged, never returned, never in a VITE_*
# variable. Just the key — not a URL or a code snippet.
# BING_SEARCH_API_KEY=

# The RapidAPI host the key is subscribed to, the country sent as `cc`, and
# how many results are asked for and shown.
# BING_SEARCH_HOST=bing-search-apis.p.rapidapi.com
# BING_SEARCH_CC=IN
# BING_SEARCH_MAX_RESULTS=10

# Give up on Bing after this long; the fallback or the index answers.
# BING_SEARCH_TIMEOUT_MS=3000

# Identical requests within this window reuse the stored response (0 disables),
# successful requests allowed per UTC day (0 = no cap; set it to fit your
# RapidAPI plan), and requests in flight at once.
# BING_SEARCH_CACHE_TTL_MS=600000
# BING_SEARCH_DAILY_LIMIT=50
# BING_SEARCH_MAX_CONCURRENT=2

# Only for tests (a local stand-in) or a proxy.
# BING_SEARCH_BASE_URL=

# Parallel Search API (https://docs.parallel.ai). Needed only for
# EXTERNAL_SEARCH_PROVIDER=parallel. Web results only: images, videos, maps
# and trends stay with SerpApi, and AI answers stay on the index. See
# docs/PARALLEL.md. Server-side only: sent in the x-api-key header, never
# logged, never returned, never in a VITE_* variable.
# PARALLEL_API_KEY=

# Parallel is asked only when this is true and a key is set. While it is not,
# no request is ever made — not even as a fallback for another provider.
# PARALLEL_ENABLED=false

# turbo | fast | basic | advanced. `fast` answers in about a second; the API's
# own default, `advanced`, takes about three.
# PARALLEL_MODE=fast

# Give up on Parallel after this long (500–15000 ms), and how many results
# are asked for and shown (1–10).
# PARALLEL_TIMEOUT_MS=4000
# PARALLEL_MAX_RESULTS=10

# Identical requests within this window reuse the stored response (0 disables),
# requests sent per UTC day (0 = no cap), and requests in flight at once.
# Every request sent counts against the daily limit, failed or not. The limit
# is a safety cap, not a figure from Parallel's pricing: set it to your plan.
# PARALLEL_CACHE_TTL_MS=600000
# PARALLEL_DAILY_LIMIT=100
# PARALLEL_MAX_CONCURRENT=2

# Images and Videos from Parallel, used only while SerpApi cannot serve those
# tabs (SERPAPI_ENABLED=false or no key). Parallel is a web search and has no
# image or video search, so nothing it returns is shown unchecked: a video
# must be one video's page on YouTube, Vimeo or Dailymotion and be confirmed
# by that platform's oEmbed endpoint; a picture must be found on a page about
# the subject, described by its own alt text/caption/file name as about it,
# and its address must really serve an image. That means this server fetches
# the pages Parallel finds (public hosts only) when someone searches Images.
# A Videos search sends three Parallel requests and an Images search two (it
# returns at most 20 pages each); all are counted in PARALLEL_DAILY_LIMIT.
# Maps works the same way: the pages Parallel finds are read for the structured
# description of a place they publish themselves (schema.org JSON-LD). Name,
# address, phone, rating and coordinates are exactly what the page states; a
# place whose page gives no coordinates is listed without a pin. A Maps search
# sends two Parallel requests. The map itself is OpenStreetMap's standard
# tiles, loaded by the browser — no key. Trending is not affected.
# Off unless "true".
# PARALLEL_VERTICALS_ENABLED=false

# Only for tests (a local stand-in) or a proxy.
# PARALLEL_BASE_URL=https://api.parallel.ai

# ---------------------------------------------------------------------------
# Maps: OpenStreetMap (Nominatim) — optional, no key
# ---------------------------------------------------------------------------
# A page states its coordinates and its address separately, and they need not
# agree. With this on, the Maps tab asks OpenStreetMap where the town an
# address names is, and pins a place only if its coordinates fall inside it;
# it also adds the places OpenStreetMap itself finds for the search. With it
# off, a pin needs another website to place something in the same town within
# 15 km, so most places are listed without pins.
#
# This sends the search text and town names to the service below. The public
# service is free and needs no key, under its usage policy
# (https://operations.osmfoundation.org/policies/nominatim/): at most one
# request a second, results cached, the application identified, attribution
# shown (the map credits OpenStreetMap), no auto-complete and no bulk use.
# The client keeps to that by construction: one request at a time, at least
# NOMINATIM_MIN_INTERVAL_MS apart, cached for a week, capped per day. One Maps
# search sends at most four requests (one place search, up to three towns),
# and usually one or two. For more than a small deployment, run your own
# Nominatim and point NOMINATIM_BASE_URL at it.
# MAPS_OSM_ENABLED=false
#
# The policy requires the application to identify itself. Give a contact:
# NOMINATIM_USER_AGENT=PH-Search-Maps/1.0 (+https://your-site.example/about-search)
# (Defaults to "PH-Search-Maps/1.0", with CRAWLER_CONTACT_URL when that is set.)
#
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_TIMEOUT_MS=5000
# NOMINATIM_MIN_INTERVAL_MS=1100     (cannot be set below 1000)
# NOMINATIM_MAX_WAIT_MS=6000         (a search waits no longer than this in the queue)
# NOMINATIM_DAILY_LIMIT=500
# NOMINATIM_CACHE_TTL_MS=604800000

# --- Less common settings --------------------------------------
# Defaults shown; uncomment to change.
#
# AI answers: ANTHROPIC_API_KEY is read when AI_API_KEY is empty.
# ANTHROPIC_API_KEY=
#
# Rate limit for /api/embed-check (the in-app browser's "can this page be
# framed?" check), per client.
# RATE_LIMIT_EMBED_WINDOW_MS=60000
# RATE_LIMIT_EMBED_MAX=60
#
# SerpApi web-search timeout. SERPAPI_WEB_TIMEOUT_MS takes precedence;
# this older name is still read when that one is unset.
# SERPAPI_TIMEOUT_MS=3000
#
# In-memory answer caches (entries kept per process).
# PARALLEL_CACHE_MAX_ENTRIES=200
# BING_SEARCH_CACHE_MAX_ENTRIES=200
# NOMINATIM_CACHE_MAX_ENTRIES=1000
