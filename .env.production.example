# ---------------------------------------------------------------------------
# PH Google — production Compose settings
#
# Copy to `.env` in the project root (next to docker-compose.yml). Compose
# reads it to fill in docker-compose.prod.yml. Never commit the copy: `.env`
# is ignored by git. The backend's own settings — MONGO_URI, JWT_SECRET,
# provider API keys — live in ph-google-backend/.env (see that .env.example
# and DEPLOYMENT.md).
# ---------------------------------------------------------------------------

# REQUIRED. The exact origin(s) users load the site from: scheme + host
# (+ port if not default), no path, no trailing slash. Comma-separated if
# more than one. This is the API's CORS allow-list.
FRONTEND_URL=https://search.example.com

# REQUIRED. Redis password. Use letters and digits only (it is embedded in a
# redis:// URL), at least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change-me-to-a-long-random-hex-string

# Where the web entry point is published. Defaults: 0.0.0.0:8080.
# Set WEB_BIND=127.0.0.1 when a reverse proxy on the same machine terminates
# TLS and forwards to it.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Proxies in front of the API trusted for the client's address. Keep 1:
# the API is reached only through this stack's nginx, which sets
# X-Forwarded-For itself. With a load balancer in front, configure nginx's
# real_ip lines instead (DEPLOYMENT.md, "Client IPs behind a load balancer").
TRUST_PROXY=1

# API log level: error | warn | info | debug. "debug" is for diagnosis only.
LOG_LEVEL=info

# OpenSearch heap. Half the container's memory, at most ~31g.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
