# --- Secrets ---------------------------------------------------------
# .env holds real database credentials and the JWT signing key. Only the
# .example files belong in the repository.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# --- Dependencies ----------------------------------------------------
node_modules/
.npm/
.pnp
.pnp.js

# --- Build output ----------------------------------------------------
dist/
build/
.vite/

# --- Test & coverage -------------------------------------------------
coverage/
.nyc_output/
# mongodb-memory-server downloads a MongoDB binary here
.cache/mongodb-binaries/

# --- Logs ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors & OS ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- Scratch ---------------------------------------------------------
tmp/
temp/
scratchpad/
_tmp_*.js
*.bak
