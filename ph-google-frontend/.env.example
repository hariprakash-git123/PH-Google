# ---------------------------------------------------------------
# PH Google frontend configuration
# Copy this file to .env for local development. Never commit .env.
#
# WARNING: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. Anything here is readable by anyone who loads the page, so it
# must never hold a secret, an API key or a credential.
# ---------------------------------------------------------------

# Base URL of the PH Google backend API, as the *browser* reaches it.
# Inside Docker this is still the host's published port, not the compose
# service name: the request is made by the browser, not by the container.
VITE_API_BASE_URL=http://localhost:5000/api
