# ---------------------------------------------------------------
# PH Google frontend configuration
# Copy this file to .env for local development. Never commit .env.
#
# WARNING: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. Anything here is readable by anyone who loads the page, so it
# must never hold a secret, an API key or a credential.
# ---------------------------------------------------------------

# Base URL of the PH Google backend API, as the *browser* reaches it.
#
# Development (`npm run dev` on :3000): the backend on the host. If it is
# unset, the app tries http://localhost:5000/api, then 5001-5003.
#
# Production (Docker image / docker-compose.prod.yml): leave it unset. The
# image builds with "/api" — the page's own origin, which the image's nginx
# proxies to the backend — and a production build never contains localhost.
VITE_API_BASE_URL=http://localhost:5000/api
